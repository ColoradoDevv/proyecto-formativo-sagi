# ── SAGI: plantilla STAGING (espejo de prod con datos desechables) ──────
# Uso: cp .env.staging.example .env   (solo en máquina/CI que pruebe staging)
# Reglas:
# 1. Proyecto Supabase DISTINTO al de prod. Jamás compartir DB entre entornos.
# 2. Rellena SOLO los <COMPLETAR>. El resto ya viene con valores seguros.
# 3. Nunca commitear el .env resultante. Solo este .example vive en git.
# Ver docs/entornos.md y docs/backups.md.

DJANGO_ENV=staging
SECRET_KEY=<COMPLETAR: genera una propia, distinta a dev y prod>
MFA_ENCRYPTION_KEY=<COMPLETAR: genera una propia, distinta a dev y prod>
DEBUG=False
ALLOWED_HOSTS=<COMPLETAR: staging.tu-dominio.edu.co>

# DB staging: pooler Supabase del proyecto STAGING (puerto 6543).
DB_ENGINE=django.db.backends.postgresql
DB_NAME=postgres
DB_USER=<COMPLETAR: ej. postgres.xxxxxstaging>
DB_PASSWORD=<COMPLETAR: ver gestor de contraseñas del equipo>
DB_HOST=<COMPLETAR: ej. aws-1-us-east-1.pooler.supabase.com>
DB_PORT=6543
# Para migraciones pesadas usa la conexión DIRECTA (solo durante `migrate`):
# DB_HOST=<COMPLETAR: db.xxxxxstaging.supabase.co>
# DB_PORT=5432

FRONTEND_URL=<COMPLETAR: https://staging.tu-dominio.edu.co>
CORS_ALLOWED_ORIGINS=<COMPLETAR: https://staging.tu-dominio.edu.co>
CSRF_TRUSTED_ORIGINS=<COMPLETAR: https://staging.tu-dominio.edu.co>

LOG_LEVEL=INFO
# SENTRY_DSN=<COMPLETAR: DSN de staging en sentry.io>

# Correo staging: cuenta de pruebas, nunca la real de prod.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=<COMPLETAR>
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=<COMPLETAR>
# EMAIL_HOST_PASSWORD=<COMPLETAR_APP_PASSWORD>
# DEFAULT_FROM_EMAIL=<COMPLETAR>
