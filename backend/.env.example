# ── SAGI: plantilla base (desarrollo local) ─────────────────────────────
# 1. Copia:  cp .env.example .env   (Windows: copy .env.example .env)
# 2. Rellena SOLO los <COMPLETAR>.
# 3. Nunca subas tu .env a git (ver .gitignore).
# 4. Modelo de entornos (ver docs/entornos.md):
#      dev     → este archivo (SQLite local, sin secretos compartidos)
#      staging → backend/.env.staging.example (proyecto Supabase STAGING)
#      prod    → backend/.env.prod.example (proyecto Supabase PROD, secretos por PaaS)
#
# De dónde sale cada valor:
#   SECRET_KEY → genera una propia, una por entorno:
#                python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
#   MFA_ENCRYPTION_KEY → llave Fernet para cifrar secretos TOTP (una por entorno,
#                NO es la SECRET_KEY; si cambia, los MFA inscritos se invalidan):
#                python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   DB_* dev   → no tocar (SQLite local ya configurado abajo).
#   EMAIL_*    → opcional. Sin esto los correos se imprimen en consola.

# ── Entorno ─────────────────────────────────────────────────────────────
DJANGO_ENV=dev
SECRET_KEY=<COMPLETAR: genera una propia para dev>
MFA_ENCRYPTION_KEY=<COMPLETAR: genera una propia para dev>

DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Proxies de confianza para rate limiting (X-Forwarded-For). VACÍO por
# defecto = solo vale REMOTE_ADDR (no falsificable). Si despliegas detrás
# de un proxy propio (nginx), pon aquí su IP para que el rate limit vea
# la IP real del cliente. JAMÁS pongas IPs públicas arbitrarias: un
# atacante rotando XFF evadiría todos los bloqueos.
# TRUSTED_PROXIES=127.0.0.1

# ── Base de datos LOCAL (dev): SQLite ───────────────────────────────────
# Recomendado para empezar. No requiere contraseña ni red.
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3

# ── Si necesitas apuntar a Supabase STAGING (temporal) ──────────────────
# 1. NO modifiques este archivo: copia backend/.env.staging.example a .env.
# 2. Pide DB_PASSWORD por gestor de contraseñas (nunca por git/Discord público).
# 3. Vuelve a SQLite al terminar para no ensuciar datos compartidos.

# Frontend (para links de firma y CORS en local)
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Observabilidad (opcional) ────────────────────────────────────────────
# LOG_LEVEL=DEBUG en local; INFO o WARNING en staging/prod.
# LOG_LEVEL=DEBUG
# SENTRY_DSN=<COMPLETAR: DSN del proyecto en sentry.io; sin esto no se reporta nada>
# SENTRY_DSN=

# ── Correo (opcional, solo si quieres envío real) ───────────────────────
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=<COMPLETAR>
# EMAIL_HOST_PASSWORD=<COMPLETAR_APP_PASSWORD>
# DEFAULT_FROM_EMAIL=<COMPLETAR>
