# ── Cómo usarlo ──────────────────────────────────────────────────────────
# 1. Copia este archivo:  cp .env.example .env   (Windows: copy .env.example .env)
# 2. Rellena SOLO los valores marcados con <COMPLETAR>.
# 3. Nunca subas tu .env a git (ya está en .gitignore).
#
# De dónde sale cada valor:
#   SECRET_KEY  → genera una propia (no reuses la de otro):
#                 python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
#   DB_*        → del proyecto Supabase compartido (pídela por canal privado:
#                 WhatsApp, gestor de contraseñas, etc. NUNCA por git/Discord
#                 público) o crea tu propio proyecto gratis en supabase.com
#                 (Project Settings > Database > Connection string > Transaction pooler).
#   EMAIL_*     → opcional. Sin esto los correos se imprimen en consola.

SECRET_KEY=<COMPLETAR>

DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Proxies de confianza para rate limiting (X-Forwarded-For). VACÍO por
# defecto = solo vale REMOTE_ADDR (no falsificable). Si despliegas detrás
# de un proxy propio (nginx), pon aquí su IP para que el rate limit vea
# la IP real del cliente. JAMÁS pongas IPs públicas arbitrarias: un
# atacante rotando XFF evadiría todos los bloqueos.
# TRUSTED_PROXIES=127.0.0.1

# ── Base de datos CENTRALIZADA: Supabase (Postgres vía pooler) ─────────
# Todos los contribuidores apuntan al MISMO proyecto. settings.py agrega
# automáticamente sslmode=require y CONN_MAX_AGE=0.
# Lo único privado es DB_PASSWORD: está en el gestor de contraseñas del
# equipo (o la pasa el dueño por canal privado). Lo demás ya viene lleno.
DB_ENGINE=django.db.backends.postgresql
DB_NAME=postgres
DB_USER=postgres.yzquqetdynzxjsfoahfh
DB_PASSWORD=<COMPLETAR: ver gestor de contraseñas del equipo>
DB_HOST=aws-1-us-east-1.pooler.supabase.com
DB_PORT=6543

# Para migraciones pesadas, Supabase recomienda la conexión DIRECTA
# (solo mientras corres `migrate`, luego vuelve al pooler):
# DB_HOST=db.yzquqetdynzxjsfoahfh.supabase.co
# DB_PORT=5432

# ── Desarrollo 100% local sin Supabase (opcional) ─────────────────────────
# Comenta el bloque Supabase y descomenta estas 2 líneas:
# DB_ENGINE=django.db.backends.sqlite3
# DB_NAME=db.sqlite3

# Frontend (para links de firma y CORS en local)
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Correo (opcional, solo si quieres envío real) ─────────────────────────
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=<COMPLETAR>
# EMAIL_HOST_PASSWORD=<COMPLETAR_APP_PASSWORD>
# DEFAULT_FROM_EMAIL=<COMPLETAR>
